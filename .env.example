# verum-hub build variables (Vercel: Project Settings → Environment Variables).
# Everything here is public: it ends up in the HTML.

# Where "Download Android APK" points. An https URL; one on files.verum.cam is
# served through this site's /r2 rewrite (some networks reset files.verum.cam).
# Unset: /r2/apk/verum.apk, i.e. https://files.verum.cam/apk/verum.apk, so
# upload the APK there or set this.
VITE_ANDROID_APK_URL=
